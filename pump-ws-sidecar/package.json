{
  "name": "pump-ws-sidecar",
  "version": "1.0.0",
  "description": "Playwright poller — pump.fun following-positions/alerts (callout/repost/reply) forwarded to fomofaster backend",
  "main": "dist/index.js",
  "scripts": {
